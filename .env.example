# Local development. Railway sets every one of these for you in production.

# Postgres. Matches the docker-compose service in this repo.
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Optional. Leave unset and Payload uses relative URLs, which is what makes the
# admin panel work on the Railway domain and on a custom domain without a redeploy.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Object storage. Leave these unset locally and uploads go to ./media on disk.
# Set them (and start MinIO with `docker compose --profile s3 up -d`) to test the
# same code path Railway uses in production.
# S3_BUCKET=payload-media
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=payload
# S3_SECRET_ACCESS_KEY=payloadpayload
# S3_FORCE_PATH_STYLE=true

# Only if 5432 is already taken on your machine. Keep DATABASE_URL in sync.
# POSTGRES_PORT=5433
